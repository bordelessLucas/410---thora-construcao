rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Orçamentos: cada usuário autenticado acessa apenas os próprios documentos.
    match /orcamentos/{docId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Metadados de upload de PDF (escrita via backend/admin SDK).
    match /uploads/{docId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create, update, delete: if false;
    }

    match /catalogo_produtos/{docId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /bdi_configs/{userId}/configs/{configId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /bdi_aplicados/{docId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Status de jobs de detecção (escrita via Admin SDK no Cloud Run).
    match /detect_jobs/{uploadId} {
      allow read: if request.auth != null
        && resource.data.user_id == request.auth.uid;
      allow create, update, delete: if false;
    }
  }
}
